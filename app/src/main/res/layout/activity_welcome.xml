<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg">

    <!-- Decorative circle top-right -->
    <View
        android:id="@+id/decorCircleTop"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@drawable/circle_decoration_top"
        android:alpha="0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Decorative circle bottom-left -->
    <View
        android:id="@+id/decorCircleBottom"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:background="@drawable/circle_decoration_bottom"
        android:alpha="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="120dp" />

    <!-- Floating leaf/particle effect view -->
    <com.example.agriconnect.ParticleView
        android:id="@+id/particleView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- Main content container -->
    <LinearLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:translationY="60dp"
        android:alpha="0"
        app:layout_constraintBottom_toTopOf="@+id/bottomCard"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.38">

        <!-- Logo with glow ring -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center">

            <View
                android:id="@+id/logoGlowRing"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center"
                android:background="@drawable/logo_glow_ring"
                android:alpha="0.5" />

            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_logo_leaf"
                android:background="@drawable/logo_bg_circle"
                android:padding="20dp"
                android:elevation="8dp" />
        </FrameLayout>

        <!-- App name with letter spacing -->
        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="AgriConnect"
            android:textColor="#FFFFFF"
            android:textSize="40sp"
            android:fontFamily="@font/montserrat_extrabold"
            android:letterSpacing="0.06"
            android:elevation="4dp" />

        <!-- Animated divider line -->
        <View
            android:id="@+id/dividerLine"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/divider_gradient"
            android:scaleX="0" />

        <!-- Tagline -->
        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Bridging the gap between Soil and Sale"
            android:textColor="#DCEDC8"
            android:textSize="15sp"
            android:fontFamily="@font/montserrat_medium"
            android:letterSpacing="0.02"
            android:gravity="center"
            android:alpha="0.9" />

        <!-- Stats row -->
        <LinearLayout
            android:id="@+id/statsRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/stats_pill_bg"
            android:paddingVertical="14dp"
            android:paddingHorizontal="28dp"
            android:alpha="0">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10K+"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:fontFamily="@font/montserrat_extrabold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Farmers"
                    android:textColor="#DCEDC8"
                    android:textSize="11sp"
                    android:fontFamily="@font/montserrat_medium"
                    android:alpha="0.8" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="24dp"
                android:background="#4DFFFFFF" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="500+"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:fontFamily="@font/montserrat_extrabold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Markets"
                    android:textColor="#DCEDC8"
                    android:textSize="11sp"
                    android:fontFamily="@font/montserrat_medium"
                    android:alpha="0.8" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="24dp"
                android:background="#4DFFFFFF" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹2Cr+"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:fontFamily="@font/montserrat_extrabold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Traded"
                    android:textColor="#DCEDC8"
                    android:textSize="11sp"
                    android:fontFamily="@font/montserrat_medium"
                    android:alpha="0.8" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Bottom card with button -->
    <LinearLayout
        android:id="@+id/bottomCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="32dp"
        android:paddingTop="32dp"
        android:paddingBottom="52dp"
        android:translationY="100dp"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Get Started Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGetStarted"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Get Started"
            android:textAllCaps="false"
            android:textColor="#1B5E20"
            android:textSize="17sp"
            android:fontFamily="@font/montserrat_extrabold"
            android:letterSpacing="0.04"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="30dp"
            app:elevation="12dp"
            app:icon="@drawable/ic_arrow_right"
            app:iconGravity="end"
            app:iconTint="#1B5E20"
            app:iconPadding="8dp" />

        <!-- Sign in text -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Already have an account? "
                android:textColor="#B0BEC5"
                android:textSize="14sp"
                android:fontFamily="@font/montserrat_medium" />

            <TextView
                android:id="@+id/tvSignIn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign In"
                android:textColor="#A5D6A7"
                android:textSize="14sp"
                android:fontFamily="@font/montserrat_extrabold" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>